source "https://rubygems.org"

# GitHub Pages builds the site with this gem; it pins Jekyll and the plugins
# to the versions GitHub actually runs.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
end

# Required on Ruby 3.x
gem "webrick", "~> 1.8"
